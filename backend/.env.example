# Copy to .env for local development. Never commit the real .env file.

# Email. Set either the Resend settings or the Gmail settings. Resend wins if both are set.
#
# Resend sends over HTTPS. Use it on Render, whose plan blocks the SMTP connection Gmail needs.
RESEND_API_KEY=
# The address enquiries come from, on a domain verified in Resend, for example website@trivistalabs.lk.
MAIL_FROM=
# Where enquiries are delivered. Required with Resend; with Gmail it defaults to EMAIL_USER.
CONTACT_TO=

# Gmail, for local development. Use a Google app password, not the account password.
EMAIL_USER=
EMAIL_PASS=

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to trivistalabs.io, trivistalabs.lk and the local Astro dev server.
CORS_ORIGINS=

# Optional. Number of proxies in front of the API. Render uses 1.
TRUST_PROXY_HOPS=1

PORT=5000
