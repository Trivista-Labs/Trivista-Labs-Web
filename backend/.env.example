# Copy to .env for local development. Never commit the real .env file.

# Gmail account the API sends from. Use a Google app password, not the account password.
EMAIL_USER=
EMAIL_PASS=

# Optional. Where enquiries are delivered. Defaults to EMAIL_USER.
CONTACT_TO=

# Optional. Comma-separated browser origins allowed to call the API.
# Defaults to trivistalabs.io, trivistalabs.lk and the local Astro dev server.
CORS_ORIGINS=

# Optional. Number of proxies in front of the API. Render uses 1.
TRUST_PROXY_HOPS=1

PORT=5000
