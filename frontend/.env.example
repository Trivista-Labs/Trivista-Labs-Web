# Copy to .env for local development.

# Contact API base URL. Defaults to the production API on Render.
# To test against a local backend (cd ../backend && npm run dev), uncomment:
# PUBLIC_CONTACT_API_URL=http://localhost:5000

# Show draft work entries in a production build, for founder review.
# Drafts always appear in `npm run dev`. Never enable this for the live site.
# PUBLIC_SHOW_DRAFTS=true
