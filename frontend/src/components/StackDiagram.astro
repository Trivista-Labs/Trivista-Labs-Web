---
import ArrowIcon from "./ArrowIcon.astro";
import ScenePoster from "./ScenePoster.astro";
import { capabilities } from "../data/capabilities";
import { render } from "../lib/scene";
import { LIGHT_PALETTE, SCENES } from "../lib/scenes";
// The four capability layers as a 3D stack: each plate is one layer, and data rises through them.
//
// Wide screens: the labels sit beside the drawing, joined to their plates by callout lines.
// Phones: numbered hotspots sit on the plates themselves; tapping one lights the plate and shows
// that layer in the panel below (src/scripts/layers.ts). Without JavaScript, the list is shown.
const WIDTH = 600;
const HEIGHT = 640;
const { model, pose } = SCENES.stack;
// Where each plate's number sits in the still drawing, as percentages. scene.ts moves the
// hotspots with the live drawing once it starts.
const { markers } = render(model, pose.frame, { width: WIDTH, height: HEIGHT, ...pose.view }, LIGHT_PALETTE);
const place = markers.map(({ x, y }) => ({ x: ((x / WIDTH) * 100).toFixed(2), y: ((y / HEIGHT) * 100).toFixed(2) }));
const number = (index: number) => String(index + 1).padStart(2, "0");
---

<figure class="system" data-scene-surface data-layers>
  <figcaption class="system__caption">
    <span class="mono-label">Where we work</span>
    <span class="system__caption-text">From the products your customers use to the infrastructure underneath.</span>
  </figcaption>

  <div class="system__viewport">
    <ScenePoster scene="stack" width={WIDTH} height={HEIGHT} class="system__stage" />
    <div class="system__hotspots" data-layer-hotspots hidden>
      {
        capabilities.map((capability, index) => (
          <button
            type="button"
            class="system__hotspot"
            data-layer-hotspot={index}
            data-x={place[index].x}
            data-y={place[index].y}
            aria-pressed={index === 0 ? "true" : "false"}
            aria-controls="layer-focus"
          >
            <span aria-hidden="true">{number(index)}</span>
            <span class="visually-hidden">
              Layer {index + 1}: {capability.layer}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="system__focus tv-frame" id="layer-focus" data-layer-focus hidden>
    <div class="system__focus-items" aria-live="polite">
      {
        capabilities.map((capability, index) => (
          <div class="system__focus-item" data-layer-item={index} hidden={index !== 0}>
            <p class="system__focus-meta">
              <span class="system__focus-number">{number(index)}</span>
              {capability.layer}
            </p>
            <p class="system__focus-title">{capability.layerDetail}</p>
            <p class="system__focus-text">{capability.problem}</p>
            <a class="link-arrow" href={`/capabilities/#${capability.id}`}>
              See this layer
              <ArrowIcon />
            </a>
          </div>
        ))
      }
    </div>
    <button type="button" class="system__next" data-layer-next>
      Next layer
      <ArrowIcon />
    </button>
  </div>

  <ol class="system__layers" role="list">
    {
      capabilities.map((capability, index) => (
        <li>
          <a class="system__layer tv-frame tv-frame--live" href={`/capabilities/#${capability.id}`} data-callout>
            <span class="system__index" aria-hidden="true">
              {number(index)}
            </span>
            <span class="system__name">{capability.layer}</span>
            <span class="system__detail">{capability.layerDetail}</span>
            <ArrowIcon />
          </a>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .system {
    position: relative;
    display: grid;
    gap: var(--space-lg);
  }
  /* A soft pool of light under the drawing, so it sits in space rather than on the page. */
  .system::before {
    content: "";
    position: absolute;
    inset: 8% 10% 12%;
    z-index: -1;
    background:
      radial-gradient(closest-side, rgb(0 209 178 / 0.12), transparent 75%),
      radial-gradient(closest-side at 50% 70%, rgb(22 24 26 / 0.06), transparent 85%);
  }
  /* Content sits above the canvas that scene.ts adds to this figure. */
  .system__caption,
  .system__layers,
  .system__focus {
    position: relative;
    z-index: 1;
  }
  .system__caption {
    display: grid;
    gap: 0.35rem;
  }
  .system__caption-text {
    max-width: 34ch;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .system__viewport {
    position: relative;
    width: min(100%, 30rem);
    justify-self: center;
    aspect-ratio: 600 / 640;
  }
  /* :global because the element belongs to ScenePoster. */
  .system__viewport :global(.system__stage) {
    width: 100%;
    height: 100%;
  }

  /* Phone hotspots: a numbered, cut marker on each plate's outer corner, with a 44px target. */
  .system__hotspots {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .system__hotspot {
    position: absolute;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transform: translate(-50%, -50%);
    -webkit-tap-highlight-color: transparent;
  }
  .system__hotspot::before {
    content: "";
    position: absolute;
    inset: 0.5rem;
    z-index: -1;
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    clip-path: polygon(5px 0, 100% 0, 100% calc(100% - 9px), calc(100% - 5px) 100%, 0 100%, 0 9px);
    transition: background-color 0.3s ease;
  }
  .system__hotspot[aria-pressed="true"]::before {
    background: var(--teal);
    box-shadow: none;
  }
  .system__hotspot[aria-pressed="true"]::after {
    content: "";
    position: absolute;
    inset: 0.15rem;
    z-index: -2;
    border: 1px solid rgb(0 209 178 / 0.45);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 8px) 100%, 0 100%, 0 14px);
  }

  /* Phone focus panel: the chosen layer, explained under the drawing. */
  .system__focus {
    --cut: 12px;
    display: grid;
    gap: var(--space-md);
    padding: var(--space-lg);
  }
  .system__focus-item {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
  }
  .system__focus-meta {
    display: flex;
    gap: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .system__focus-number {
    color: var(--teal-ink);
  }
  .system__focus-title {
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .system__focus-text {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .system__next {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 0.1rem;
    border: 0;
    border-top: 1px solid var(--rule);
    background: none;
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
  }
  .system__next :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--teal-ink);
  }
  /* With the phone switcher running, the panel replaces the list. */
  .system:global(.is-switchable) .system__layers {
    display: none;
  }

  .system__layers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.5rem;
  }
  .system__layer {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.1rem 0.75rem;
    --cut: 9px;
    --frame-fill: rgb(252 251 248 / 0.92);
    padding: 0.7rem 0.85rem;
    text-decoration: none;
    transition:
      --frame-edge 0.45s ease,
      transform var(--duration) var(--ease-out);
  }
  .system__index {
    grid-row: span 2;
    color: var(--teal-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .system__name {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }
  .system__detail {
    grid-column: 2;
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.3;
  }
  .system__layer :global(svg) {
    grid-column: 3;
    grid-row: 1 / span 2;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--muted);
    transition:
      transform var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }
  .system__layer:hover,
  .system__layer:focus-visible {
    transform: translateX(3px);
  }
  .system__layer:hover :global(svg) {
    color: var(--teal-ink);
    transform: translateX(3px);
  }

  /* From here the labels sit beside the drawing, joined to their plates by callout lines. */
  @media (min-width: 40em) {
    .system {
      grid-template-columns: minmax(0, 1fr) minmax(11rem, 13.5rem);
      column-gap: var(--space-lg);
    }
    .system__caption {
      grid-column: 1 / -1;
    }
    .system__viewport {
      width: 100%;
    }
    .system__layers {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
      gap: clamp(0.75rem, 2vw, 1.6rem);
      padding-block: 8% 12%;
    }
  }
</style>
