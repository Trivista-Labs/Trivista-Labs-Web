---
import ArrowIcon from "./ArrowIcon.astro";
import CapabilityGlyph from "./CapabilityGlyph.astro";
import { capabilities } from "../data/capabilities";
// The four layers as an index, read top to bottom like the hero's stack: a large layer number,
// the problem, what we deliver, and the layer's own plate in a cut frame. The frames step down
// the page in a stagger that crosses the row lines, rather than sitting in a card grid.
---

<ol class="layers" role="list" data-reveal-group data-carousel>
  {
    capabilities.map((capability, index) => (
      <li class="layer">
        <span class="layer__index" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <div class="layer__head">
          <p class="eyebrow">{capability.label}</p>
          <h3 class="layer__title">
            <a href={`/capabilities/#${capability.id}`}>
              {capability.title}
              <ArrowIcon />
            </a>
          </h3>
        </div>
        <div class="layer__body">
          <p class="layer__problem">{capability.problem}</p>
          <ul class="layer__list" role="list">
            {capability.deliverables.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="layer__visual tv-frame tv-frame--live">
          <CapabilityGlyph layer={index} class="layer__glyph" />
        </div>
      </li>
    ))
  }
</ol>
<div class="layers__pager" aria-hidden="true" data-carousel-pager>
  <span class="layers__count"><span data-carousel-current>01</span> / {String(capabilities.length).padStart(2, "0")}</span>
  <span class="layers__bars">
    {capabilities.map((_, index) => <span class:list={{ "is-current": index === 0 }} data-carousel-bar />)}
  </span>
  <span class="layers__hint">Swipe</span>
</div>

<style>
  .layers {
    display: grid;
  }
  .layer {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md) var(--space-lg);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--rule);
  }
  .layer:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .layer__index {
    grid-row: span 2;
    color: var(--rule-strong);
    font-family: var(--font-mono);
    font-size: clamp(2.25rem, 1.6rem + 2.4vw, 4.25rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.06em;
    transition: color 0.45s ease;
  }
  .layer__head,
  .layer__body {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
  }
  .layer__title {
    font-size: var(--text-xl);
  }
  .layer__title a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  /* The whole row follows the link. */
  .layer__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .layer__title a :global(svg) {
    flex: none;
    width: 0.8em;
    height: 0.8em;
    color: var(--teal-ink);
    transition: transform 0.45s var(--ease-out-expo);
  }
  .layer__problem {
    max-width: 44ch;
    color: var(--ink-2);
  }
  /* Deliverables as a technical list, separated by slashes, not pill badges. */
  .layer__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }
  .layer__list li:not(:last-child)::after {
    content: "/";
    margin-inline: 0.6em;
    color: var(--rule-strong);
  }
  .layer__visual {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    padding: var(--space-md);
    --frame-fill: var(--lattice) center / var(--lattice-size), #f3f1ea;
  }
  :global(.layer__glyph) {
    max-width: 15rem;
  }
  .layer:hover .layer__index {
    color: var(--teal-ink);
  }
  .layer:hover .layer__title a :global(svg) {
    transform: translateX(4px);
  }
  .layer:hover :global(.layer__glyph) {
    transform: translate(-3px, -5px);
  }

  .layers__pager {
    display: none;
  }

  /* Phones: the layers become a swipeable row of cards, each led by its drawing, with the next
     card peeking in. The pager shows which layer is in view. */
  @media (max-width: 39.99em) {
    .layers {
      display: flex;
      gap: var(--space-md);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) var(--space-xs);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .layers::-webkit-scrollbar {
      display: none;
    }
    .layer {
      flex: 0 0 86%;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      gap: var(--space-sm);
      padding-block: 0;
      border: 0;
      scroll-snap-align: start;
    }
    .layer:last-child {
      border-bottom: 0;
    }
    .layer__visual {
      order: -1;
      min-height: 11.5rem;
    }
    .layer__index {
      grid-row: auto;
      margin-top: var(--space-xs);
      font-size: 1.75rem;
    }
    .layers__pager {
      display: flex;
      align-items: center;
      gap: var(--space-md);
      margin-top: var(--space-lg);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.75rem;
    }
    .layers__bars {
      display: flex;
      gap: 4px;
    }
    .layers__bars span {
      width: 1.1rem;
      height: 0.35rem;
      background: var(--rule-strong);
      transform: skewX(-30deg);
      transition: background-color 0.3s ease;
    }
    .layers__bars span.is-current {
      background: var(--teal-ink);
    }
    .layers__hint {
      margin-left: auto;
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }
  }

  /* From tablet width: number, heading, text and plate in four columns, the plates stepping down. */
  @media (min-width: 56em) {
    .layer {
      grid-template-columns: 5.5rem minmax(0, 4fr) minmax(0, 5fr) minmax(0, 3.2fr);
      column-gap: var(--space-xl);
      padding-block: var(--space-2xl);
    }
    .layer__index {
      grid-row: auto;
    }
    .layer__visual {
      grid-column: auto;
      align-self: start;
      margin-block: -1.25rem;
    }
    .layer:nth-child(even) .layer__visual {
      transform: translateY(1.75rem);
    }
  }
</style>
