---
import { Picture } from "astro:assets";
import ArrowIcon from "./ArrowIcon.astro";
import { STATUS_LABELS, workHref, type WorkEntry } from "../lib/work";

interface Props {
  entry: WorkEntry;
  headingLevel?: 2 | 3;
  /** Full-width layout, used when a single project is shown. */
  featured?: boolean;
}

const { entry, headingLevel = 3, featured = false } = Astro.props;
const { data } = entry;
const href = workHref(entry);
const isExternal = Boolean(href) && !data.caseStudy;
const host = isExternal && href ? new URL(href).host.replace(/^www\./, "") : undefined;
const siteHost = data.url ? new URL(data.url).host.replace(/^www\./, "") : undefined;
const Heading = headingLevel === 2 ? "h2" : "h3";
// Screenshots are shown as the product itself: the site in a browser window, the phone view in front.
---

<article
  class:list={[
    "work-card",
    {
      "work-card--linked": Boolean(href),
      "work-card--media": Boolean(data.cover),
      "work-card--featured": featured,
    },
  ]}
  data-reveal="project"
  data-tilt-area
>
  {
    data.cover && (
      <div class="showcase tv-frame tv-frame--dark">
        {(data.coverLabel || data.screenLabel) && (
          <p class="showcase__notes" aria-hidden="true">
            {data.coverLabel && <span class="showcase__note">01 {data.coverLabel}</span>}
            {data.screen && data.screenLabel && (
              <span class="showcase__note showcase__note--screen">02 {data.screenLabel}</span>
            )}
          </p>
        )}
        <div class="showcase__stage" data-tilt>
          <div class="showcase__browser">
            <div class="showcase__bar" aria-hidden="true">
              <span class="showcase__dots">
                <span />
                <span />
                <span />
              </span>
              {siteHost && <span class="showcase__url">{siteHost}</span>}
            </div>
            <Picture
              src={data.cover}
              alt={data.coverAlt ?? ""}
              formats={["avif", "webp"]}
              widths={[480, 720, 960, 1280, 1600]}
              sizes={featured ? "(min-width: 60em) 44rem, 100vw" : "(min-width: 48em) 38rem, 100vw"}
            />
            <span class="showcase__glare" aria-hidden="true" />
          </div>
          {data.screen && (
            <div class="showcase__phone">
              <Picture
                src={data.screen}
                alt={data.screenAlt ?? ""}
                formats={["avif", "webp"]}
                widths={[180, 270, 360, 540]}
                sizes={featured ? "(min-width: 60em) 11rem, 24vw" : "24vw"}
              />
            </div>
          )}
        </div>
      </div>
    )
  }
  <div class="work-card__body">
    <div class="work-card__head">
      <div class="work-card__meta">
        <span class="eyebrow">{data.category}</span>
        {data.status && (
          <span class="work-card__status tv-state" data-state={data.status}>
            {STATUS_LABELS[data.status]}
          </span>
        )}
        {data.draft && <span class="work-card__draft">Draft</span>}
      </div>
      <Heading class="work-card__title">
        {
          href ? (
            <a href={href}>
              {data.title}
              <ArrowIcon />
            </a>
          ) : (
            data.title
          )
        }
      </Heading>
    </div>
    <div class="work-card__text">
      <p class="work-card__summary">{data.summary}</p>
      {host && <p class="mono-label">{host}</p>}
    </div>
  </div>
</article>

<style>
  .work-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--ink);
  }
  .work-card--media {
    gap: var(--space-xl);
    padding-top: 0;
    border-top: 0;
  }

  /* The showcase: a dark stage lit in teal, with the product in perspective. */
  .showcase {
    --cut: 22px;
    --frame-fill:
      radial-gradient(80% 70% at 70% 15%, rgb(0 209 178 / 0.18), transparent 62%),
      var(--lattice-dark) center bottom / var(--lattice-size),
      linear-gradient(160deg, var(--graphite-2) 0%, var(--graphite) 100%);
    overflow: hidden;
    padding: clamp(2.25rem, 5vw, 3.5rem) clamp(1rem, 4vw, 3rem) clamp(2.5rem, 7vw, 5rem);
    perspective: 1800px;
  }
  /* Callouts, as on a technical drawing: a label and a leader line cut at 60 degrees. */
  .showcase__notes {
    position: absolute;
    top: 0.9rem;
    right: clamp(1rem, 4vw, 3rem);
    left: clamp(1rem, 4vw, 3rem);
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--on-dark-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }
  .showcase__note {
    position: relative;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--line-dark-strong);
  }
  .showcase__note::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 0;
    width: 1px;
    height: 0.9rem;
    background: var(--line-dark-strong);
    transform: skewX(-30deg);
    transform-origin: top;
  }
  .showcase__note--screen::after {
    right: 0;
    left: auto;
    transform: skewX(30deg);
  }
  .showcase__stage {
    position: relative;
    transform-style: preserve-3d;
  }
  .showcase__browser {
    position: relative;
    overflow: hidden;
    border-radius: 7px;
    background: var(--paper);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 40px 60px -30px rgb(0 0 0 / 0.85),
      0 20px 44px -24px rgb(0 209 178 / 0.35);
    transform: rotateY(-10deg) rotateX(5deg);
    transform-origin: 70% 50%;
    transition: transform 0.9s var(--ease-out-expo);
  }
  .showcase__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 1.75rem;
    padding-inline: 0.75rem;
    border-bottom: 1px solid #dcd8ce;
    background: #ecebe6;
  }
  .showcase__dots {
    display: flex;
    gap: 0.3rem;
  }
  .showcase__dots span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #cbc7bd;
  }
  .showcase__url {
    padding: 0.1rem 0.6rem;
    border-radius: 3px;
    background: #f8f7f3;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .showcase__browser :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }
  /* Light catching the glass. */
  .showcase__glare {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.22) 0%, transparent 38%);
  }
  .showcase__phone {
    position: absolute;
    right: 5%;
    bottom: -10%;
    width: 24%;
    overflow: hidden;
    padding: 4px;
    border-radius: 18px;
    background: #0b0c0e;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.14),
      0 30px 44px -20px rgb(0 0 0 / 0.9),
      0 0 28px -8px rgb(0 209 178 / 0.35);
    transform: rotateY(-10deg) rotateX(5deg) translateZ(90px);
    transition: transform 0.9s var(--ease-out-expo);
  }
  .showcase__phone :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 17;
    object-fit: cover;
    object-position: top;
    border-radius: 14px;
  }
  .work-card:hover .showcase__browser {
    transform: rotateY(-6deg) rotateX(3deg);
  }
  .work-card:hover .showcase__phone {
    transform: rotateY(-6deg) rotateX(3deg) translateZ(130px) translateY(-4%);
  }

  .work-card__body,
  .work-card__head,
  .work-card__text {
    display: grid;
    align-content: start;
    gap: var(--space-sm);
  }
  .work-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .work-card__status {
    color: var(--ink-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .work-card__draft {
    padding: 0.1rem 0.45rem;
    border: 1px dashed var(--rule-strong);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .work-card__title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-display);
  }
  .work-card__title a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }
  /* The whole card is the link target. */
  .work-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .work-card__title a :global(svg) {
    flex: none;
    width: 0.7em;
    height: 0.7em;
    color: var(--teal-ink);
    transition: transform var(--duration) var(--ease-out);
  }
  .work-card--linked:hover .work-card__title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
  }
  .work-card--linked:hover .work-card__title a :global(svg) {
    transform: translateX(3px);
  }
  .work-card__summary {
    max-width: 52ch;
    color: var(--ink-2);
  }
  /* The work grid has two columns from 48em, so a lone featured card spans both from there. */
  @media (min-width: 48em) {
    .work-card--featured {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 60em) {
    .work-card--featured:not(.work-card--media) .work-card__body {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-3xl);
    }
    .work-card--featured .work-card__summary {
      font-size: var(--text-lg);
    }
    /* Text beside the showcase, with the product taking the larger share. */
    .work-card--featured.work-card--media {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      align-items: center;
      column-gap: var(--space-3xl);
    }
    .work-card--featured.work-card--media .work-card__body {
      grid-row: 1;
      grid-column: 1;
      gap: var(--space-lg);
    }
    .work-card--featured.work-card--media .showcase {
      grid-row: 1;
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-card:hover .showcase__browser {
      transform: rotateY(-10deg) rotateX(5deg);
    }
    .work-card:hover .showcase__phone {
      transform: rotateY(-10deg) rotateX(5deg) translateZ(90px);
    }
  }
</style>
