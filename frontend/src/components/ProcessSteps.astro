---
import { processSteps } from "../data/process";

interface Props {
  /** Use the longer description of each stage. */
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
// Styled for dark sections only.
---

<ol class="steps" role="list">
  {
    processSteps.map((step, index) => (
      <li class="step">
        <span class="step__number" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3 class="step__title">{step.title}</h3>
        <p class="step__text">{detailed ? step.detail : step.summary}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    border-top: 1px solid var(--rule-dark);
  }
  .step {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-content: start;
    gap: 0.35rem var(--space-md);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--rule-dark);
  }
  .step__number {
    grid-row: span 2;
    padding-top: 0.25rem;
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .step__title {
    font-size: var(--text-lg);
  }
  .step__text {
    color: var(--on-dark-2);
  }
  @media (min-width: 40em) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
  @media (min-width: 64em) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
