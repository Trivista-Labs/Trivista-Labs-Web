---
import { processSteps } from "../data/process";

interface Props {
  /** Use the longer description of each stage. */
  detailed?: boolean;
}

const { detailed = false } = Astro.props;
// Styled for dark sections only. Each stage sits on a track that lights up in order as the list
// scrolls into view (motion.ts adds is-pending, then is-inview). Without that, the track is lit.
---

<ol class="steps" role="list" data-inview>
  {
    processSteps.map((step, index) => (
      <li class="step">
        <span class="step__node" aria-hidden="true" />
        <span class="step__number" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3 class="step__title">{step.title}</h3>
        <p class="step__text">{detailed ? step.detail : step.summary}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-content: start;
    gap: 0.35rem var(--space-md);
    padding-block: var(--space-xl);
    border-top: 1px solid var(--line-dark);
    transition: background-color 0.4s ease;
  }
  /* The lit track along the top of each stage. */
  .step::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, var(--teal) 0%, rgb(0 209 178 / 0.25) 70%, transparent 100%);
    transform-origin: left;
    transition: transform 1.1s var(--ease-out-expo);
  }
  /* A node where the track meets each stage, glowing once it is reached. */
  .step__node {
    position: absolute;
    top: -3px;
    left: 2px;
    width: 14px;
    height: 6px;
    border: 1px solid var(--teal);
    background: var(--graphite);
    box-shadow: 0 0 12px 1px var(--teal-glow);
    transform: skewX(-30deg);
    transition:
      background-color 0.5s ease,
      box-shadow 0.5s ease;
  }
  .steps:not(.is-pending) .step__node,
  .steps.is-inview .step__node {
    background: var(--teal);
  }
  .steps.is-pending:not(.is-inview) .step::before {
    transform: scaleX(0);
  }
  .steps.is-pending:not(.is-inview) .step__node {
    box-shadow: none;
  }
  .step:nth-child(2)::before,
  .step:nth-child(2) .step__node {
    transition-delay: 0.14s;
  }
  .step:nth-child(3)::before,
  .step:nth-child(3) .step__node {
    transition-delay: 0.28s;
  }
  .step:nth-child(4)::before,
  .step:nth-child(4) .step__node {
    transition-delay: 0.42s;
  }
  .step:nth-child(5)::before,
  .step:nth-child(5) .step__node {
    transition-delay: 0.56s;
  }
  .step:nth-child(6)::before,
  .step:nth-child(6) .step__node {
    transition-delay: 0.7s;
  }
  .step__number {
    grid-row: span 2;
    padding-top: 0.25rem;
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .step__title {
    font-size: var(--text-lg);
  }
  .step__text {
    color: var(--on-dark-2);
  }
  .step:hover {
    background: linear-gradient(180deg, rgb(0 209 178 / 0.05), transparent 80%);
  }
  @media (min-width: 40em) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-2xl);
    }
  }
  @media (min-width: 64em) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
