---
import ScenePoster from "./ScenePoster.astro";

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  /** The 3D site plan behind the header. Off for pages meant for reading, such as legal text. */
  scene?: boolean;
}

const { eyebrow, title, lede, scene = true } = Astro.props;
---

<section class:list={["page-hero", "tech-grid", { "page-hero--scene": scene }]} data-scene-surface={scene ? "" : undefined}>
  {scene && <ScenePoster scene="field" width={1200} height={480} fit="xMaxYMid slice" class="page-hero__scene" />}
  <div class="container page-hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-hero__title">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    --grid-focus: 80% 60%;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .page-hero--scene {
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  /* The scene and its live canvas rise out of the right-hand side, clear of the text. */
  .page-hero :global(.page-hero__scene),
  .page-hero :global(.scene-canvas) {
    position: absolute;
    inset: 0;
    -webkit-mask-image: linear-gradient(100deg, transparent 38%, rgb(0 0 0 / 0.55) 58%, #000 78%);
    mask-image: linear-gradient(100deg, transparent 38%, rgb(0 0 0 / 0.55) 58%, #000 78%);
  }
  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--space-lg);
  }
  .page-hero__title {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1.4rem + 3.3vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  /* On narrow screens the scene sits low and faint, below the words. */
  @media (max-width: 47.99em) {
    .page-hero :global(.page-hero__scene),
    .page-hero :global(.scene-canvas) {
      opacity: 0.55;
      -webkit-mask-image: linear-gradient(180deg, transparent 40%, #000 90%);
      mask-image: linear-gradient(180deg, transparent 40%, #000 90%);
    }
  }
</style>
