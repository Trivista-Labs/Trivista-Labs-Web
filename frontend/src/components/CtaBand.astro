---
import PenroseMark from "./PenroseMark.astro";
import { site } from "../data/site";
import { applicationMailto } from "../lib/careers";

interface Props {
  /** Where the band sits, for analytics. */
  location: string;
  /** "careers" asks for a CV, by email to the careers inbox, instead of a project. */
  variant?: "project" | "careers";
}

const { location, variant = "project" } = Astro.props;
// The closing band is dark and runs straight into the footer, with the Trivista mark as its object.
const content =
  variant === "careers"
    ? {
        eyebrow: "Careers",
        title: "Tell us what you’d like to build.",
        text: "Send your CV with a link to something you’ve made, and tell us which area interests you.",
        action: { label: "Send your CV", href: applicationMailto(site.careersEmail), track: "CV email clicked" },
        email: { address: site.careersEmail, href: applicationMailto(site.careersEmail), track: "CV email clicked" },
      }
    : {
        eyebrow: "Start a project",
        title: "Tell us what you’re building.",
        text: `Share a few details about your project, and a member of our team will reply ${site.responseTime}.`,
        action: { label: "Start a project", href: "/contact/", track: "Start a project clicked" },
        email: { address: site.email, href: `mailto:${site.email}`, track: "Email clicked" },
      };
---

<section class="cta surface-dark tv-panel" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div class="cta__content" data-reveal>
      <div class="cta__heading">
        <p class="eyebrow">{content.eyebrow}</p>
        <h2 class="cta__title" id="cta-title">{content.title}</h2>
      </div>
      <div class="cta__body">
        <p class="cta__text">{content.text}</p>
        <div class="cta__actions">
          <a class="button button--primary" href={content.action.href} data-track={content.action.track} data-track-location={location}>
            {content.action.label}
          </a>
          <p class="cta__email">
            or email <a class="link" href={content.email.href} data-track={content.email.track} data-track-location={location}
              >{content.email.address}</a
            >
          </p>
        </div>
      </div>
    </div>
    <PenroseMark class="cta__mark" />
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section);
    background:
      radial-gradient(42rem 30rem at 80% 45%, rgb(0 209 178 / 0.14), transparent 65%),
      linear-gradient(180deg, var(--graphite) 0%, var(--charcoal) 100%);
  }
  /* The grid recedes towards the footer. */
  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--lattice-dark) center / var(--lattice-size);
    -webkit-mask-image: radial-gradient(ellipse 55% 70% at 78% 45%, #000 15%, transparent 75%);
    mask-image: radial-gradient(ellipse 55% 70% at 78% 45%, #000 15%, transparent 75%);
  }
  .cta__inner {
    display: grid;
    align-items: center;
    gap: var(--space-2xl);
  }
  .cta__content {
    display: grid;
    gap: var(--space-xl);
  }
  .cta__heading {
    display: grid;
    gap: var(--space-md);
  }
  .cta__title {
    max-width: 14ch;
    font-size: var(--text-display);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
  }
  .cta__body {
    display: grid;
    gap: var(--space-lg);
  }
  .cta__text {
    max-width: 40ch;
    color: var(--on-dark-2);
    font-size: var(--text-lg);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .cta__email {
    color: var(--on-dark-2);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  /* :global because the element belongs to PenroseMark, which scoped styles here can't reach. */
  .cta :global(.cta__mark) {
    width: min(15rem, 62vw);
    justify-self: center;
  }
  @media (min-width: 60em) {
    .cta__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-3xl);
    }
    .cta :global(.cta__mark) {
      width: min(100%, 21rem);
    }
  }
</style>
