---
import ArrowIcon from "./ArrowIcon.astro";
import BrandMark from "./BrandMark.astro";
import { navigation, site } from "../data/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const onContact = isCurrent("/contact/");
---

<header class="site-header" data-site-header>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label="Trivista Labs home">
      <BrandMark />
      <span class="brand__name">Trivista Labs</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list" role="list">
        {
          navigation.map((item) => (
            <li>
              <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="button button--primary"
        href="/contact/"
        aria-current={onContact ? "page" : undefined}
        data-track="Start a project clicked"
        data-track-location="header"
      >
        Start a project
      </a>
    </nav>

    <a class="menu-toggle" href="#site-footer-nav" data-nav-fallback>
      <span class="menu-toggle__glyph" aria-hidden="true"></span>Menu
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-nav-toggle
      hidden
    >
      <span class="menu-toggle__glyph" aria-hidden="true"></span>
      <span data-nav-label>Menu</span>
    </button>
  </div>

  <div class="mobile-menu surface-dark" id="mobile-menu" data-nav-menu hidden>
    <nav class="container mobile-menu__inner" aria-label="Main">
      <ol class="mobile-menu__list" role="list">
        {
          navigation.map((item, index) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                <span class="mobile-menu__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                {item.label}
                <ArrowIcon />
              </a>
            </li>
          ))
        }
      </ol>
      <a
        class="button button--primary mobile-menu__cta"
        href="/contact/"
        data-track="Start a project clicked"
        data-track-location="mobile-menu"
      >
        Start a project
      </a>
      <p class="mobile-menu__meta">
        <a href={`mailto:${site.email}`} data-track="Email clicked" data-track-location="mobile-menu">{site.email}</a>
        <span>{site.locality}, {site.country}</span>
      </p>
    </nav>
  </div>
</header>

<style>
  /* The header stays with the reader: translucent ivory over the page, lifting once it scrolls. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--rule);
    /* Nearly opaque rather than blurred: a backdrop blur over the animated hero repaints every frame. */
    background: rgb(246 244 238 / 0.94);
    transition:
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }
  .site-header:global(.is-scrolled) {
    border-color: rgb(22 24 26 / 0.08);
    box-shadow: 0 10px 30px -18px rgb(22 24 26 / 0.35);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: 4.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .site-nav {
    display: none;
    align-items: center;
    gap: var(--space-xl);
  }
  .site-nav__list {
    display: flex;
    gap: var(--space-xl);
  }
  /* The underline draws in from the left; the current page keeps a teal one. */
  .site-nav__link {
    position: relative;
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .site-nav__link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-expo);
  }
  .site-nav__link:hover {
    color: var(--ink);
  }
  .site-nav__link:hover::after {
    transform: scaleX(1);
  }
  .site-nav__link[aria-current="page"] {
    color: var(--ink);
  }
  .site-nav__link[aria-current="page"]::after {
    background: var(--teal-ink);
    transform: scaleX(1);
  }
  /* The phone toggle: a mono label led by the tri-band, whose teal segment lights when open. */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.25rem 0.5rem 0.75rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }
  .menu-toggle__glyph {
    flex: none;
    width: 1.5rem;
    height: 0.55rem;
    background: linear-gradient(90deg, #c9c5bb 0 28%, transparent 28% 36%, var(--ink-2) 36% 64%, transparent 64% 72%, var(--ink-2) 72%);
    transform: skewX(-30deg);
    transition: background 0.3s ease;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle__glyph {
    background: linear-gradient(90deg, #c9c5bb 0 28%, transparent 28% 36%, var(--ink-2) 36% 64%, transparent 64% 72%, #00a58c 72%);
  }

  /* The phone menu: a full-height graphite sheet on the lattice, cut open from the top. */
  .mobile-menu {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    background:
      radial-gradient(40rem 26rem at 100% 0%, rgb(0 209 178 / 0.12), transparent 60%),
      var(--lattice-dark) center top / var(--lattice-size),
      linear-gradient(180deg, var(--charcoal) 0%, var(--graphite) 100%);
    animation: menu-open 0.45s var(--ease-out-expo);
  }
  @keyframes menu-open {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .mobile-menu__inner {
    display: grid;
    align-content: start;
    gap: var(--space-xl);
    min-height: 100%;
    padding-block: var(--space-lg) var(--space-2xl);
  }
  .mobile-menu__list li {
    animation: menu-item 0.6s var(--ease-out-expo) backwards;
  }
  .mobile-menu__list li:nth-child(2) {
    animation-delay: 0.06s;
  }
  .mobile-menu__list li:nth-child(3) {
    animation-delay: 0.12s;
  }
  /* Links arrive along the 60-degree axis, like section headings. */
  @keyframes menu-item {
    from {
      opacity: 0;
      transform: translate(-0.6rem, 1.05rem);
    }
  }
  .mobile-menu__list a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line-dark);
    color: var(--on-dark);
    font-size: clamp(1.75rem, 1.2rem + 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
  }
  .mobile-menu__list a :global(svg) {
    align-self: center;
    width: 1.1rem;
    height: 1.1rem;
    margin-left: auto;
    color: var(--teal);
  }
  .mobile-menu__index {
    color: var(--on-dark-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .mobile-menu__list a[aria-current="page"] {
    color: var(--teal);
  }
  .mobile-menu__cta {
    width: 100%;
    min-height: 3.25rem;
  }
  .mobile-menu__meta {
    display: grid;
    gap: 0.35rem;
    color: var(--on-dark-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  .mobile-menu__meta a {
    color: var(--on-dark);
    text-underline-offset: 0.2em;
  }
  /* The page behind the open menu stays still (site.ts sets the class). */
  :global(html.is-menu-open) {
    overflow: hidden;
  }
  /* Must match DESKTOP in src/scripts/site.ts. */
  @media (min-width: 60em) {
    .site-nav {
      display: flex;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>
