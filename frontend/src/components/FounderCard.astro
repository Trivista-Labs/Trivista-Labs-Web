---
import { Picture } from "astro:assets";
import type { Founder } from "../data/founders";

interface Props {
  founder: Founder;
}

const { founder } = Astro.props;
---

<article class="founder">
  <div class="founder__frame">
    <Picture
      src={founder.photo}
      alt={`Portrait of ${founder.name}`}
      formats={["avif", "webp"]}
      widths={[208, 320, 480, 640, 960]}
      sizes="(min-width: 64em) 24rem, (min-width: 40em) 45vw, 6.5rem"
    />
  </div>
  <div class="founder__body">
    <p class="mono-label founder__role">{founder.role}</p>
    <h3 class="founder__name">{founder.name}</h3>
    <p class="founder__title">{founder.title}</p>
    <p class="founder__focus">{founder.focus}</p>
    {
      founder.linkedin && (
        <a class="link founder__link" href={founder.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn
          <span class="visually-hidden"> profile of {founder.name} (opens in a new tab)</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .founder {
    display: grid;
    grid-template-columns: minmax(0, 6.5rem) minmax(0, 1fr);
    align-content: start;
    align-items: start;
    gap: var(--space-md);
  }
  /* The portrait sits in a raised frame; on hover it lifts and a teal edge catches the light. */
  .founder__frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--rule);
    box-shadow: var(--shadow-1);
    transition:
      transform 0.7s var(--ease-out-expo),
      box-shadow 0.7s var(--ease-out-expo);
  }
  .founder__frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgb(22 24 26 / 0.08),
      inset 0 -80px 60px -60px rgb(0 209 178 / 0);
    transition: box-shadow 0.7s var(--ease-out-expo);
  }
  .founder :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out-expo);
  }
  .founder:hover .founder__frame {
    box-shadow: var(--shadow-2);
    transform: translateY(-4px);
  }
  .founder:hover .founder__frame::after {
    box-shadow:
      inset 0 0 0 1px rgb(0 209 178 / 0.55),
      inset 0 -80px 60px -60px rgb(0 209 178 / 0.35);
  }
  .founder:hover :global(img) {
    transform: scale(1.035);
  }
  @media (prefers-reduced-motion: reduce) {
    .founder:hover .founder__frame,
    .founder:hover :global(img) {
      transform: none;
    }
  }
  .founder__body {
    display: grid;
    gap: 0.2rem;
  }
  .founder__role {
    color: var(--teal-ink);
  }
  .founder__name {
    margin-top: 0.15rem;
    font-size: var(--text-xl);
  }
  .founder__title {
    font-weight: 500;
  }
  .founder__focus {
    margin-top: 0.35rem;
    color: var(--ink-2);
  }
  .founder__link {
    margin-top: 0.35rem;
    justify-self: start;
  }
  @media (min-width: 40em) {
    .founder {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
