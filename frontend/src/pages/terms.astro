---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
// Plain-language terms that match what the site does today. Have them reviewed before launch.
---

<BaseLayout
  title="Terms of Use | Trivista Labs"
  description="The terms that apply when you use trivistalabs.io, the website of Trivista Labs (Pvt) Ltd in Colombo, Sri Lanka."
>
  <PageHero eyebrow="Legal" title="Terms of Use">
    <p class="mono-label">Last updated <time datetime={site.legalUpdated.iso}>{site.legalUpdated.display}</time></p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="prose">
        <p>
          These terms apply to your use of trivistalabs.io, the website of {site.legalName}. By using the site, you
          agree to them.
        </p>

        <h2>Using this website</h2>
        <p>
          You may use this website to learn about Trivista Labs and to contact us. Please do not use it for anything
          unlawful, or try to disrupt it or gain access to systems or data you are not authorised to access.
        </p>

        <h2>Content</h2>
        <p>
          The text, design and logo on this website belong to Trivista Labs unless stated otherwise. Project names,
          screenshots and trademarks belong to their owners and are shown with permission. Please ask us before copying
          or reusing our content.
        </p>

        <h2>No offer or advice</h2>
        <p>
          The information on this website is general. It is not an offer to provide services and does not create a
          contract. Any project we take on is covered by a separate written agreement.
        </p>

        <h2>Links to other websites</h2>
        <p>
          We link to other websites, such as our social media profiles and live projects. We are not responsible for
          their content or for how they handle your information.
        </p>

        <h2>Liability</h2>
        <p>
          We work to keep this website accurate and available, but we provide it as it is, without guarantees. To the
          extent the law allows, we are not liable for losses that come from using it.
        </p>

        <h2>Governing law</h2>
        <p>These terms are governed by the laws of Sri Lanka, and the courts of Sri Lanka decide any dispute about them.</p>

        <h2>Changes</h2>
        <p>We may update these terms. The date at the top shows when they last changed.</p>

        <h2>Contact</h2>
        <p>
          {site.legalName}, {site.locality}, {site.country}. Email: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
