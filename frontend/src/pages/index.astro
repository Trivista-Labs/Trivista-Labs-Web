---
import ArrowIcon from "../components/ArrowIcon.astro";
import CapabilityGrid from "../components/CapabilityGrid.astro";
import CtaBand from "../components/CtaBand.astro";
import FounderCard from "../components/FounderCard.astro";
import Principles from "../components/Principles.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import SectionHeading from "../components/SectionHeading.astro";
import StackDiagram from "../components/StackDiagram.astro";
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { founders } from "../data/founders";
import { site } from "../data/site";
import { organizationSchema, websiteSchema } from "../lib/seo";
import { getWork } from "../lib/work";

// The lead project in full, then the next two side by side.
const work = (await getWork()).slice(0, 3);
---

<BaseLayout
  title="Trivista Labs | Software engineering company in Sri Lanka"
  description={site.description}
  schema={[organizationSchema(), websiteSchema()]}
>
  <section class="hero tech-grid" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="eyebrow">Trivista Labs &middot; {site.locality}, {site.country}</p>
        <h1 class="hero__title" id="hero-title">
          We design and build the software your business <span class="hero__title-accent">runs on.</span>
        </h1>
        <p class="lede">
          Trivista Labs is an engineering company in {site.locality}. We build web and mobile products, business
          systems such as ERP and booking platforms, connected hardware, and the infrastructure that keeps them
          running.
        </p>
        <div class="hero__actions">
          <a
            class="button button--primary"
            href="/contact/"
            data-track="Start a project clicked"
            data-track-location="hero"
          >
            Start a project
          </a>
          <a class="link-arrow" href="/capabilities/">See what we build<ArrowIcon /></a>
        </div>
      </div>
      <StackDiagram />
    </div>
  </section>

  <section class="section tone-tint" aria-labelledby="build-title">
    <div class="container">
      <SectionHeading eyebrow="What we build" title="Four kinds of systems, one team." id="build-title" index={1}>
        <p>Most businesses need more than one of these. They work best when they are designed together.</p>
      </SectionHeading>
      <CapabilityGrid />
    </div>
  </section>

  {
    work.length > 0 && (
      <section class="section tone-warm" aria-labelledby="work-title">
        <div class="container">
          <SectionHeading eyebrow="Selected work" title="Products and systems we have built." id="work-title" index={2}>
            <a class="link-arrow" href="/work/">
              All work
              <ArrowIcon />
            </a>
          </SectionHeading>
          <div class="work-grid">
            {work.map((entry, index) => (
              <WorkCard entry={entry} featured={index === 0} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--dark" aria-labelledby="process-title">
    <div class="container">
      <SectionHeading eyebrow="How we build" title="From the first conversation to a system in use." id="process-title" index={3}>
        <p>
          The stages we take a project through, from understanding the problem to improving the system once people
          are using it.
        </p>
      </SectionHeading>
      <ProcessSteps />
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <SectionHeading eyebrow="Engineering" title="What we hold our work to." id="principles-title" index={4} />
      <Principles />
    </div>
  </section>

  <section class="section tone-warm" aria-labelledby="founders-title">
    <div class="container">
      <SectionHeading eyebrow="Company" title="Led by its three founders." id="founders-title" index={5}>
        <p>Trivista Labs is run by the people who design and build its systems.</p>
        <a class="link-arrow" href="/company/">
          About the company
          <ArrowIcon />
        </a>
      </SectionHeading>
      <div class="founder-grid" data-reveal-group>
        {founders.map((founder) => <FounderCard founder={founder} />)}
      </div>
    </div>
  </section>

  <CtaBand location="home" />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(3.5rem, 2rem + 6vw, 7.5rem);
  }
  /* Both columns start at the top, so the headline sits just under the header instead of being
     centred against the taller drawing. */
  .hero__grid {
    display: grid;
    align-items: start;
    gap: var(--space-2xl);
  }
  .hero__text {
    display: grid;
    justify-items: start;
    gap: var(--space-lg);
  }
  .hero__title {
    max-width: 15ch;
    font-size: clamp(2.5rem, 1.45rem + 3.6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.042em;
  }
  /* The last words carry the one accent in the headline. */
  .hero__title-accent {
    color: var(--teal-ink);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-xl);
    margin-top: var(--space-xs);
  }
  .hero {
    --grid-focus: 78% 45%;
    overflow: clip;
  }
  @media (min-width: 60em) {
    .hero__grid {
      grid-template-columns: minmax(0, 5.5fr) minmax(0, 6.5fr);
      gap: var(--space-2xl);
    }
  }
</style>
