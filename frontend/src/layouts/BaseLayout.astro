---
import "../styles/global.css";
import "../styles/depth.css";
import BaseHead from "../components/BaseHead.astro";
import JsonLdScript from "../components/JsonLd.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { JsonLd } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  schema?: readonly JsonLd[];
}

const { schema = [], ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
    {schema.map((data) => <JsonLdScript data={data} />)}
  </head>
  <body>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/site";
      import "../scripts/motion";

      // The 3D renderer loads only on pages that have a scene.
      if (document.querySelector("[data-scene]")) void import("../scripts/scene");
      // The phone annotations for the hero stack load only where the stack is.
      if (document.querySelector("[data-layers]")) void import("../scripts/layers");
    </script>
  </body>
</html>
